# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Ваш Telegram ID — владелец: подтверждает оплату Kaspi, видит /users и /stats.
# Пусто — владельцем станет первый, кто нажмёт /start.
ADMIN_ID=

# Тестовый доступ новичку — TRIAL_DAYS дней. Тест и платный доступ работают одинаково: поиск раз в
# POLL_SEC сек + турбо, до PAID_SUBS поисков; разница только в сроке. Без доступа — не проверяется.
TRIAL_DAYS=7
POLL_SEC=2
PAID_SUBS=20
# «Новое» — подано не раньше стольких минут назад (не меньше интервала бесплатной проверки)
FRESH_MIN=30

# Тарифы: цены на 7,14,30 дней через запятую — по площадке или «всё сразу» (ALL, комбо).
# Пусто — тариф не продаётся этим способом.
# Telegram Stars (1 Star ≈ 0,013 $):
STARS_PRICES_OLX=100,180,300
STARS_PRICES_KOLESA=100,180,300
STARS_PRICES_KRISHA=100,180,300
STARS_PRICES_KASPI=60,100,180
STARS_PRICES_ALL=250,450,800
# Kaspi, тенге:
KASPI_PRICES_OLX=1500,2500,4500
KASPI_PRICES_KOLESA=1500,2500,4500
KASPI_PRICES_KRISHA=1500,2500,4500
KASPI_PRICES_KASPI=900,1500,2700
KASPI_PRICES_ALL=4000,7000,12000
# Реквизиты, которые увидит покупатель Kaspi:
KASPI_DETAILS=Перевод на Kaspi по номеру +7 7XX XXX XX XX (Имя Ф.)

# Разделы карточки объявления: specs — характеристики, description — описание,
# seller — продавец (имя, частник/бизнес, с какого времени на OLX)
CARD_SECTIONS=specs,description,seller
# Водяной знак на фото: auto — @имя_бота, off — без знака, или свой текст (латиница)
WATERMARK=auto

# Турбо: следующие номера объявлений раз в TURBO_SEC сек, по TURBO_WINDOW номеров за раз
TURBO_SEC=1
TURBO_WINDOW=10
# Шаблон ссылки «все объявления автора» ({code} — код продавца, как в ссылках OLX; {id} — его номер)
SELLER_URL=https://www.olx.kz/list/user/{code}/
# Прокси для запросов к OLX (необязательно): раскомментируйте обе строки
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@host:port
