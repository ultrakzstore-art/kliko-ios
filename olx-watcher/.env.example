# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Ваш Telegram ID — владелец: подтверждает оплату Kaspi, видит /users и /stats.
# Пусто — владельцем станет первый, кто нажмёт /start.
ADMIN_ID=

# Тестовый доступ новичку — TRIAL_HOURS часов (по умолчанию сутки). Тест и платный доступ работают одинаково: поиск раз в
# POLL_SEC сек + турбо, до PAID_SUBS поисков; разница только в сроке. Без доступа — не проверяется.
TRIAL_HOURS=24
POLL_SEC=2
PAID_SUBS=20
# «Новое» — подано не раньше стольких минут назад (не меньше интервала бесплатной проверки)
FRESH_MIN=30

# Тарифы: цены на 24 часа, 7, 14, 30 дней через запятую (три числа — без тарифа на сутки) —
# по площадке или «всё сразу» (ALL, комбо). Пусто — тариф этим способом не продаётся.
# Telegram Stars:
STARS_PRICES_OLX=20,100,180,300
STARS_PRICES_KOLESA=20,100,180,300
STARS_PRICES_KRISHA=20,100,180,300
STARS_PRICES_KASPI=20,80,150,250
STARS_PRICES_ALL=50,250,450,800
# Kaspi, тенге:
KASPI_PRICES_OLX=500,2990,4990,8990
KASPI_PRICES_KOLESA=500,2990,4990,8990
KASPI_PRICES_KRISHA=500,2990,4990,8990
KASPI_PRICES_KASPI=500,1990,3990,6990
KASPI_PRICES_ALL=990,4990,8990,14990
# Реквизиты, которые увидит покупатель Kaspi:
KASPI_DETAILS=Перевод на Kaspi по номеру +7 7XX XXX XX XX (Имя Ф.)

# Разделы карточки объявления: specs — характеристики, description — описание,
# seller — продавец (имя, частник/бизнес, с какого времени на OLX)
CARD_SECTIONS=specs,description,seller
# Водяной знак на фото: auto — @имя_бота, off — без знака, или свой текст (латиница)
WATERMARK=auto

# Турбо: следующие номера объявлений раз в TURBO_SEC сек, по TURBO_WINDOW номеров за раз
TURBO_SEC=1
# Лента самых свежих объявлений всей доски OLX — раз в BOARD_SEC сек (главный источник нового)
BOARD_SEC=2
# Скидки: «📉 Цена снижена», если цена упала хотя бы на MIN_DROP % (off — выключить)
DISCOUNTS=on
MIN_DROP=3
TURBO_WINDOW=10
# Прокси для запросов к OLX (необязательно): раскомментируйте обе строки
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@host:port
# VIP-рубрика (эксклюзив OLX, /buyvip), 7/14/30 дней: не заданы — ×50 от цен OLX
STARS_PRICES_VIP=5000,9000,15000
KASPI_PRICES_VIP=75000,125000,225000
