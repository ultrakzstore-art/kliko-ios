# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Ваш Telegram ID — владелец: подтверждает оплату Kaspi, видит /users и /stats.
# Пусто — владельцем станет первый, кто нажмёт /start.
ADMIN_ID=

# Платный доступ: проверка раз в POLL_SEC сек + турбо. Бесплатный: раз в FREE_POLL_SEC сек, без турбо.
POLL_SEC=30
FREE_POLL_SEC=600
FREE_SUBS=3
PAID_SUBS=20
# «Новое» — подано не раньше стольких минут назад (не меньше интервала бесплатной проверки)
FRESH_MIN=30

# Цены на 7,14,30 дней через запятую. Пусто — способ оплаты выключен.
# Telegram Stars (1 Star ≈ 0,013 $):
STARS_PRICES=100,180,300
# Kaspi, тенге, и реквизиты, которые увидит покупатель:
KASPI_PRICES=1500,2500,4500
KASPI_DETAILS=Перевод на Kaspi по номеру +7 7XX XXX XX XX (Имя Ф.)

# Турбо: следующие номера объявлений раз в TURBO_SEC сек, по TURBO_WINDOW номеров за раз
TURBO_SEC=5
TURBO_WINDOW=10
# Шаблон ссылки «все объявления автора» ({id} — номер продавца)
SELLER_URL=https://www.olx.kz/list/user/{id}/
# Прокси для запросов к OLX (необязательно): раскомментируйте обе строки
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@host:port
