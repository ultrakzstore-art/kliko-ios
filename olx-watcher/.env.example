# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Ваш Telegram ID — боту будете писать только вы. Пусто — владельцем станет первый, кто нажмёт /start.
OWNER_ID=
# Как часто проверять каждый поиск, сек
POLL_SEC=30
# Турбо: проверка следующих номеров объявлений напрямую, раз в N сек, по W номеров за раз
TURBO_SEC=5
TURBO_WINDOW=10
# Шаблон ссылки «все объявления автора» ({id} — номер продавца)
SELLER_URL=https://www.olx.kz/list/user/{id}/
# Прокси для запросов к OLX (необязательно): раскомментируйте обе строки
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@host:port
