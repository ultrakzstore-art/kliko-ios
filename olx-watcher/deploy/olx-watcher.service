[Unit]
Description=OLX Watcher — Telegram-бот новых объявлений
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=olxbot
WorkingDirectory=__DIR__
ExecStart=/usr/bin/node --no-warnings --env-file=.env src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
