{
  "name": "olx-watcher",
  "version": "1.0.0",
  "description": "Личный телеграм-бот: новые объявления OLX.kz по вашим поискам — через секунды после подачи",
  "private": true,
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/index.js",
    "probe": "node --no-warnings --env-file-if-exists=.env src/probe.js",
    "test": "node --no-warnings --test",
    "desktop": "electron .",
    "check": "node test/syntax.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "grammy": "^1.46.0",
    "jimp": "^1.6.1"
  },
  "productName": "OLX Watcher",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kz.olxwatcher.desktop",
    "productName": "OLX Watcher",
    "files": [
      "src/**/*",
      "desktop/**/*",
      "package.json",
      "!**/node_modules/**/{test,tests,__tests__,docs,doc,example,examples,benchmark,benchmarks}/**",
      "!**/node_modules/**/*.{md,markdown,map,ts,flow}",
      "!**/node_modules/**/{CHANGELOG,HISTORY,AUTHORS,CONTRIBUTING}*"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png",
      "artifactName": "OLX-Watcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OLX-Watcher-Setup-${version}.${ext}",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ultrakzstore-art",
        "repo": "kliko-ios",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "ru",
      "en-US"
    ]
  }
}
